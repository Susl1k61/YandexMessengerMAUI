<?xml version="1.0" encoding="utf-8"?>
<!-- Файл: Platforms/Android/AndroidManifest.xml -->
<!-- Регистрируем deep link схему yandexmessenger:// для Android -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:allowBackup="true" android:icon="@mipmap/appicon"
                 android:roundIcon="@mipmap/appicon_round"
                 android:supportsRtl="true"
                 android:label="Yandex Messenger">

        <activity android:name="com.microsoft.maui.MainActivity"
                  android:exported="true"
                  android:launchMode="singleTop"
                  android:theme="@style/Maui.SplashTheme"
                  android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboard|keyboardHidden|navigation">

            <!-- Стандартный запуск -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link: yandexmessenger://callback?... -->
            <!-- Яндекс OAuth редиректит сюда после авторизации -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="yandexmessenger"
                      android:host="callback" />
            </intent-filter>

        </activity>
    </application>

    <!-- Разрешения -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
