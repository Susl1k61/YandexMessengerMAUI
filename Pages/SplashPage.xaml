<?xml version="1.0" encoding="utf-8" ?>
<!-- Файл: Pages/SplashPage.xaml -->
<!-- Экран загрузки: определяет, куда перейти при запуске -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="YandexMessengerMAUI.Pages.SplashPage"
             Shell.NavBarIsVisible="False">
    <Grid BackgroundColor="{StaticResource BackgroundDark}">
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16">
            <!-- Логотип / название -->
            <Label Text="💬" FontSize="64" HorizontalOptions="Center" />
            <Label Text="Yandex Messenger"
                   Style="{StaticResource PageTitleStyle}"
                   FontSize="24"
                   HorizontalOptions="Center" />
            <ActivityIndicator IsRunning="True" Color="{StaticResource AccentGreen}"
                               HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
