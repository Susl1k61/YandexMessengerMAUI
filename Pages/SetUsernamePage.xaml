<?xml version="1.0" encoding="utf-8" ?>
<!-- Файл: Pages/SetUsernamePage.xaml -->
<!-- Выбор юзернейма при первом входе -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="YandexMessengerMAUI.Pages.SetUsernamePage"
             Title="Выберите имя">

    <Grid RowDefinitions="*,Auto,*" Padding="32">

        <VerticalStackLayout Grid.Row="0" VerticalOptions="End" Spacing="10">
            <Label Text="Выберите юзернейм"
                   Style="{StaticResource PageTitleStyle}"
                   HorizontalOptions="Center" />
            <Label Text="По нему вас будут находить другие пользователи"
                   Style="{StaticResource SecondaryTextStyle}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="14" Margin="0,30">

            <!-- Поле ввода юзернейма -->
            <Frame BackgroundColor="{StaticResource BackgroundCard}"
                   BorderColor="{StaticResource Separator}"
                   CornerRadius="10" Padding="4,0">
                <Entry x:Name="UsernameEntry"
                       Placeholder="@yourname"
                       Text="{Binding Username}"
                       MaxLength="20"
                       Keyboard="Text"
                       ReturnCommand="{Binding ConfirmCommand}" />
            </Frame>

            <Label Text="3–20 символов: буквы, цифры, подчёркивание"
                   Style="{StaticResource SecondaryTextStyle}"
                   HorizontalOptions="Center" />

            <!-- Индикатор загрузки -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />

            <!-- Кнопка подтверждения -->
            <Button Text="Продолжить"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ConfirmCommand}"
                    IsEnabled="{Binding IsUsernameValid}" />

            <!-- Ошибка -->
            <Frame BackgroundColor="#3A1515"
                   BorderColor="{StaticResource ErrorRed}"
                   CornerRadius="8" Padding="14,10"
                   IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource ErrorRed}"
                       FontSize="13"
                       HorizontalTextAlignment="Center" />
            </Frame>

        </VerticalStackLayout>

    </Grid>
</ContentPage>
